{
    "name": "agentory-cli",
    "version": "1.4.2",
    "description": "CLI to scaffold ERC-8004 compliant AI agents with A2A, MCP, and x402 support",
    "type": "module",
    "bin": {
        "agentory": "dist/index.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "tsx src/index.ts",
        "test:e2e": "tsx tests/e2e-a2a-client.ts",
        "test": "vitest run",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "test:neox": "vitest run --config vitest.neox.config.ts",
        "test:watch": "vitest",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "erc-8004",
        "8004",
        "ai-agent",
        "a2a",
        "mcp",
        "x402",
        "ethereum",
        "web3",
        "scaffold",
        "cli"
    ],
    "author": "",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AxLabs/agentory-cli.git"
    },
    "bugs": {
        "url": "https://github.com/AxLabs/agentory-cli/issues"
    },
    "homepage": "https://github.com/AxLabs/agentory-cli#readme",
    "dependencies": {
        "@4mica/sdk": "^0.5.3",
        "@solana/web3.js": "^1.98.0",
        "bs58": "^6.0.0",
        "chalk": "^5.3.0",
        "inquirer": "^9.2.23",
        "ora": "^8.0.1",
        "viem": "^2.21.0"
    },
    "devDependencies": {
        "@4mica/x402": "^0.1.0",
        "@modelcontextprotocol/sdk": "^1.0.0",
        "@types/inquirer": "^9.0.7",
        "@types/node": "^20.10.0",
        "@x402/evm": "^2.2.0",
        "@x402/fetch": "^2.2.0",
        "dotenv": "^16.4.5",
        "tsx": "^4.7.0",
        "typescript": "^5.3.0",
        "vitest": "^4.0.18"
    },
    "engines": {
        "node": ">=18"
    }
}
